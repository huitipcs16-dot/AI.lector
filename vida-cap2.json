er":null,"gender":null,"box":[0.803,0.237,0.173,0.035]}],[{"text":"Y SAPIN, EL REINO HUMANO Y FÁCILMENTE LA REGIÓN MÁS POBLADA.","lang":"es","translation":"Y Sapin, el reino humano y fácilmente la región más poblada.","speaker":null,"gender":null,"box":[0.259,0.723,0.541,0.197]}],[{"text":"TANTO ESTE MUNDO COMO EL ANTERIOR REINO COMPARTEN EL SISTEMA MONÁRQUICO,","lang":"es","translation":"Tanto este mundo como el anterior reino comparten el sistema monárquico,","speaker":null,"gender":null,"box":[0.224,0.082,0.576,0.28]},{"text":"SET","lang":"en","translation":"set","speaker":null,"gender":null,"box":[0.266,0.625,0.075,0.044]}],[{"text":"PERO AQUÍ EL GOBIERNO SE TRANSMITE EN LUGAR DE ELEGIRSE.","lang":"es","translation":"Pero aquí el gobierno se transmite en lugar de elegirse.","speaker":null,"gender":null,"box":[0.205,0.067,0.594,0.301]},{"text":"RUDO SORDO","lang":"es","translation":"Rudo sordo","speaker":null,"gender":null,"box":[0.504,0.653,0.135,0.079]}],[{"text":"DESDE EL PRINCIPIO DESCUBRÍ QUE ESTE MUNDO ESTÁ MUY POCO DESARROLLADO EN COMPARACIÓN CON MI ANTIGUO MUNDO,","lang":"es","translation":"Desde el principio descubrí que este mundo está muy poco desarrollado en comparación con mi antiguo mundo.","speaker":null,"gender":null,"box":[0.18,0.044,0.638,0.28]}],[{"text":"PERO ME DI CUENTA DE QUE LA RAZÓN DE LA FALTA DE AVANCE TECNOLÓGICO...","lang":"es","translation":"Pero me di cuenta de que la razón de la falta de avance tecnológico...","speaker":null,"gender":null,"box":[0.053,0.061,0.58,0.208]},{"text":"¡AH, AQUÍ ESTÁ!","lang":"es","translation":"¡Ah, aquí está!","speaker":null,"gender":null,"box":[0.144,0.784,0.284,0.164]}],[{"text":"Guía para principiantes para el Mago privilegiado","lang":"es","translation":"Guía para principiantes para el Mago privilegiado","speaker":null,"gender":null,"box":[0.29,0.3,0.42,0.13]},{"text":"...ES POR LA MAGIA","lang":"es","translation":"...Es por la magia.","speaker":null,"gender":null,"box":[0.46,0.77,0.32,0.06]}],[{"text":"...nor's Guide","lang":"en","translation":"Guía del...","speaker":null,"gender":null,"box":[0.058,0.158,0.178,0.104]},{"text":"Mag...","lang":"en","translation":"Mag...","speaker":null,"gender":null,"box":[0.312,0.217,0.153,0.065]}],[{"text":"CREO QUE\nAQUÍ ES\nDONDE LO\nDEJÉ...","lang":"es","translation":"Creo que aquí es donde lo dejé...","speaker":null,"gender":null,"box":[0.304,0.092,0.285,0.1]},{"text":"EN MI ANTIGUO MUNDO\nTENÍAMOS UN FLUJO VITAL\nLLAMADO \"KI\", USADO POR\nLOS PRACTICANTES PARA\nFORTALECER SUS\nCUERPOS Y ARMAS\nMEDIANTE UN RIGUROSO\nENTRENAMIENTO.","lang":"es","translation":"En mi antiguo mundo teníamos un flujo vital llamado \"Ki\", usado por los practicantes para fortalecer sus cuerpos y armas mediante un riguroso entrenamiento.","speaker":null,"gender":null,"box":[0.225,0.716,0.55,0.215]}],[],[{"text":"ESTE MUNDO TIENE UNA FUERZA SIMILAR LLAMADA \"MANA\".","lang":"es","translation":"Este mundo tiene una fuerza similar llamada \"mana\".","speaker":null,"gender":null,"box":[0.323,0.196,0.377,0.34]},{"text":"AUN ASÍ A DIFERENCIA DEL KI QUE EXISTE SOLO EN EL INTERIOR DE LA PERSONA, EL MANÁ ESTÁ PRESENTE A NUESTRO ALREDEDOR.","lang":"es","translation":"Aun así, a diferencia del ki que existe solo en el interior de la persona, el maná está presente a nuestro alrededor.","speaker":null,"gender":null,"box":null}],[{"text":"RASCAR","lang":"es","translation":"Rascar","speaker":null,"gender":null,"box":[0.757,0.574,0.164,0.073]},{"text":"RASCAR","lang":"es","translation":"Rascar","speaker":null,"gender":null,"box":[0.565,0.713,0.164,0.067]}],[{"text":"1","lang":"es","translation":"1","speaker":null,"gender":null,"box":[0.167,0.232,0.031,0.041]},{"text":"100","lang":"es","translation":"100","speaker":null,"gender":null,"box":[0.662,0.232,0.078,0.041]},{"text":"EL PODER PARA CONTROLAR EL MANÁ ES EN GRAN MEDIDA GENÉTICA. APROXIMADAMENTE 1 DE CADA 100 NIÑOS LO POSEEN.","lang":"es","translation":"El poder para controlar el maná es en gran medida genética. Aproximadamente 1 de cada 100 niños lo poseen.","speaker":null,"gender":null,"box":[0.156,0.683,0.684,0.26]}],[{"text":"¡MALDITO SAMPULLIDO A CAUSA DEL PANAL!","lang":"es","translation":"¡Maldito sampullido a causa del panal!","speaker":null,"gender":"male","box":[0.689,0.187,0.246,0.193]},{"text":"RASCAR","lang":"es","translation":"Rascar","speaker":null,"gender":null,"box":[0.635,0.391,0.165,0.047]},{"text":"DE TODAS MANERAS... EL MANA PUEDE SER USADO DE VARIAS FORMAS.","lang":"es","translation":"De todas maneras... el mana puede ser usado de varias formas.","speaker":null,"gender":null,"box":[0.176,0.728,0.274,0.173]}],[{"text":"LOS MÉTODOS MÁS COMLINES SON \"POTENCIACIÓN\" Y \"CONJURACION\".","lang":"es","translation":"Los métodos más comunes son \"potenciación\" y \"conjuración\".","speaker":null,"gender":null,"box":[0.141,0.128,0.758,0.198]}],[{"text":"LOS \"POTENCIADORES\"\nMEJORAN SUS CUERPOS CON\nMANÁ, PERMITIÉNDOLES\nOBTENER UNA FUERZA,\nPROTECCIÓN Y AGILIDAD\nINCREÍBLES.","lang":"es","translation":"Los \"potenciadores\" mejoran sus cuerpos con maná, permitiéndoles obtener una fuerza, protección y agilidad increíbles.","speaker":null,"gender":null,"box":[0.111,0.057,0.777,0.181]},{"text":"SIN EMBARGO, SU DEBILIDAD\nRADICA EN SU LIMITADO\nALCANCE.","lang":"es","translation":"Sin embargo, su debilidad radica en su limitado alcance.","speaker":null,"gender":null,"box":[0.101,0.813,0.898,0.124]}],[{"text":"LOS \"CONJURADORES\"\nEMITEN MANÁ AL MUNDO\nEXTERIOR,\nPERMITIÉNDOLES\nDOBLEGAR EL ENTORNO\nA SU VOLUNTAD.","lang":"es","translation":"Los \"conjuradores\" emiten maná al mundo exterior, permitiéndoles doblegar el entorno a su voluntad.","speaker":null,"gender":null,"box":[0.268,0.101,0.464,0.163]}],[{"text":"SIN EMBARGO,\nDEBEN\nCOMPLEMENTAR SU\nPROPIO MANÁ CON\nEL DEL MUNDO\nEXTERIOR PARA\nFORMAR UN\nHECHIZO.","lang":"es","translation":"Sin embargo, deben complementar su propio maná con el del mundo exterior para formar un hechizo.","speaker":null,"gender":null,"box":[0.252,0.04,0.468,0.233]}],[{"text":"MI MADRE ERA LO QUE ELLOS LLAMABAN \"DESVIADOR\", MÁS ESPECÍFICAMENTE UN \"EMISOR\".","lang":"es","translation":"Mi madre era lo que ellos llamaban \"desviador\", más específicamente un \"emisor\".","speaker":null,"gender":null,"box":[0.147,0.062,0.753,0.246]}],[{"text":"SON UN RARO TIPO DE MAGO, CAPACES DE LANZAR UN MANÁ RESTAURATIVO ÚNICO.","lang":"es","translation":"Son un raro tipo de mago, capaces de lanzar un maná restaurativo único.","speaker":null,"gender":null,"box":[0.405,0.182,0.41,0.143]}],[{"text":"DE ACUERDO CON ESTE LIBRO, EL PRIMER DESPERTAR DE UN MAGO SUCEDE ENTRE LA ADOLESCENCIA TEMPRANA Y LOS ÚLTIMOS AÑOS DE LA MISMA,","lang":"es","translation":"De acuerdo con este libro, el primer despertar de un mago sucede entre la adolescencia temprana y los últimos años de la misma.","speaker":null,"gender":null,"box":[0.258,0.052,0.454,0.234]},{"text":"CUANDO EL NÚCLEO DE MANÁ SE MANIFIESTA.","lang":"es","translation":"Cuando el núcleo de maná se manifiesta.","speaker":null,"gender":null,"box":[0.194,0.613,0.275,0.143]},{"text":"EL NÚCLEO DE MANÁ SONABA EXTRAÑAMENTE SIMILAR AL CENTRO KI EN MI ANTERIOR VIDA.","lang":"es","translation":"El núcleo de maná sonaba extrañamente similar al centro ki en mi anterior vida.","speaker":null,"gender":null,"box":[0.415,0.791,0.468,0.17]}],[{"text":"PARA FORMAR EL CENTRO KI, LOS NIÑOS ERAN ENSEÑADOS A MEDITAR Y SENTIR LOS FRAGMENTOS DE KI DISPERSADOS EN EL INTERIOR DE SUS CUERPOS Y JUNTARLOS EN UN ÚNICO LUGAR.","lang":"es","translation":"Para formar el centro Ki, los niños eran enseñados a meditar y sentir los fragmentos de Ki dispersados en el interior de sus cuerpos y juntarlos en un único lugar.","speaker":null,"gender":null,"box":[0.157,0.048,0.684,0.255]}],[{"text":"ME PREGUNTO...","lang":"es","translation":"Me pregunto...","speaker":null,"gender":null,"box":[0.294,0.081,0.347,0.166]}],[],[{"text":"¡ESTÁ FUNCIONANDO! ESTA FUNCO----","lang":"es","translation":"¡Está funcionando! Esta funco...","speaker":null,"gender":null,"box":[0.345,0.878,0.283,0.068]}],[{"text":"AGARRAR","lang":"es","translation":"Agarrar","speaker":null,"gender":null,"box":[0.505,0.165,0.212,0.032]},{"text":"¡Aquí estás, Art!\nPreocupándome as-","lang":"es","translation":"¡Aquí estás, Art! Preocupándome as-","speaker":"Mujer","gender":"female","box":[0.488,0.837,0.321,0.118]}],[{"text":"Oh cariño... ¿Estás teniendo problemas para hacer caquita?","lang":"es","translation":"Oh cariño... ¿estás teniendo problemas para hacer caquita?","speaker":null,"gender":"female","box":[0.407,0.355,0.383,0.225]}],[{"text":"¡MADRE!\n¡ESTABA A PUNTO DE\nEMPEZAR MI VIAJE\nPARA CONVERTIRME EN\nEL MAGO MAS GRANDE\nDE ESTE MUNDO!\n¡NO ME HAGAS\nPARECER UN BEBÉ\nESTRENIDO!","lang":"es","translation":"¡Madre! ¡Estaba a punto de empezar mi viaje para convertirme en el mago más grande de este mundo! ¡No me hagas parecer un bebé estrenido!","speaker":null,"gender":"male","box":[0.235,0.085,0.48,0.27]},{"text":"OLOR","lang":"es","translation":"Olor","speaker":null,"gender":null,"box":[0.135,0.73,0.15,0.04]}],[{"text":"Bueno, supongo que no tienes ningún problema.","lang":"es","translation":"Bueno, supongo que no tienes ningún problema.","speaker":null,"gender":"female","box":[0.046,0.023,0.611,0.182]},{"text":"¡Hora de cambiar tu pañal!","lang":"es","translation":"¡Hora de cambiar tu pañal!","speaker":null,"gender":"female","box":[0.487,0.805,0.31,0.191]}],[{"text":"RESULTA QUE\nEN MEDIO\nDE MI\nCONCENTRACIÓN\nHABIA\nMANCHADO EL\nPANAL","lang":"es","translation":"Resulta que en medio de mi concentración había manchado el panal.","speaker":null,"gender":null,"box":[0.286,0.475,0.423,0.216]},{"text":"-Continuara-","lang":"es","translation":"Continuará.","speaker":null,"gender":null,"box":[0.697,0.946,0.257,0.032]}]]}